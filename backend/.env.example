# Nova AI Assistant — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# NEVER put real keys in this file — it IS committed to git.

# ── Required ─────────────────────────────────────────────────────────────────

# Groq API key — get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────

# Override the primary Groq model (default: meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Vision model for image analysis (POST /vision).
# Must support image (multimodal) input.
# See the current list at: https://console.groq.com/docs/vision
#
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Android companion (optional) ─────────────────────────────────────────────
# Secret key for Android device registration and command dispatch.
# Required only if using the Android companion app.
# NOVA_ADMIN_KEY=your_random_secret_here

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# RATE_CHAT_RPM=20
# RATE_DEVICE_RPM=60
# RATE_GLOBAL_RPM=120

# ── Agent loop (optional) ───────────────────────────────────────────────────
# Max LLM <-> tool round-trips per /chat request (default: 4).
# AGENT_MAX_STEPS=4
# Hard wall-clock cap for the whole loop, in seconds (default: 45).
# AGENT_TIMEOUT_S=45
# Number of previous conversation turns (user+bot pairs) to inject as
# history context (default: 10 pairs = 20 messages).
# AGENT_HISTORY_TURNS=10

# ── Supabase — Auth + Profile ─────────────────────────────────────────────────
# Required for email+password login and user profiles.
# Find these in your Supabase project: Settings → API
#
# SUPABASE_URL     : Project URL  (e.g. https://xxxx.supabase.co)
# SUPABASE_KEY     : Anon/public key — safe for backend use with RLS enabled
# SUPABASE_JWT_SECRET : JWT secret from Settings → API → JWT Settings
#                       Used to verify tokens issued by Supabase Auth.
#                       NEVER expose this to the frontend.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ── Supabase — Service Role Key (for account deletion only) ──────────────────
# Required ONLY for the DELETE /privacy/account endpoint to delete the
# Supabase auth.users row.  Without this, all user data is wiped but the
# Supabase account itself remains.
#
# Find this in Supabase: Settings → API → service_role (secret) key.
# NEVER expose this key to the frontend or commit it to git.
# Keep it server-side only.
#
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
